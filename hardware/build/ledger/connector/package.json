{
  "name": "@jelurida/ledgerjs-connector",
  "version": "1.1.0",
  "description": "Ledger Hardware Wallet Connector for Ardor",
  "source": "src/connector.template.js",
  "default": "lib/ledger.connector.js",
  "targets": {
    "default": {
      "context": "browser",
      "outputFormat": "global",
      "isLibrary": false,
      "sourceMap": false,
      "scopeHoist": false
    }
  },
  "dependencies": {
    "@ledgerhq/hw-transport-webusb": "^6.28.5"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "parcel": "^2.9.3",
    "process": "^0.11.10"
  },
  "scripts": {
    "build": "parcel build"
  },
  "alias": {
    "@ledgerhq/devices": "@ledgerhq/devices/lib-es"
  }
}
